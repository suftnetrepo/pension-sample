{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Import": {
    "BatchExpiryHours": 24,
    "MarkerDays": 7,
    "MaxFileBytes": 10485760,
    "MaxLines": 50000,
    "RequireWarningsAcknowledged": true
  },
  "Infrastructure": {
    "ConfigPath": "../../config",
    "IntellipenMapping": "",
    "Persistence": "Sqlite",
    "SqliteConnectionString": "Data Source=../../data/intellipen-import.db",
    "OutputPath": "../../output",
    "Email": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "From": "",
      "To": []
    }
  }
}
